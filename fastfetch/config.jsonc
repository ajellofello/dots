{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
	"logo": {
		"type": "auto",
		"position": "left",
		"padding": {
			"right": 3,
      "top": 1,
			"left": 1,
		},
		"color": {
			"1": "blue",
			"2": "blue",
		},
	},
	"display": {
		"separator": "",
		"color": {
			"keys": "yellow",
		},
		"key": {
			"width": 9, // Aligns keys to this width
			"type": "string", // string, icon, both, or none
		},
	},
	"modules": [
		{
			"type": "os",
			"key": "os",
			"format": "{name}",
		},
		{
			"type": "uptime",
			"key": "uptime",
			"format": "{hours} Hours {minutes} Minutes",
		},
		{
			"type": "shell",
			"key": "shell",
			"format": "{exe-name}",
		},
		{
			"type": "cpu",
			"key": "cpu",
			"format": "{name}",
		},
		{
			"type": "memory",
			"key": "mem",
			"format": "{used}/{total}",
		},
		{
			"type": "disk",
			"key": "disk",
			"format": "{size-used}/{size-total}",
		},
		"break",
		{
			"type": "colors",
			"symbol": "block",
			"brightness": "normal",
		},
	],
}
