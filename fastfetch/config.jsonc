{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
	"logo": {
    "type": "file",
		"source": "~/.config/fastfetch/ascii-art/sonic.txt",
		"position": "left",
		"padding": {
			"right": 3,
      "top": 0,
			"left": 1,
		},
		"color": {
			"1": "red",
			"2": "red",
		},
	},
	"display": {
		"separator": "",
		"color": {
			"keys": "red",
		},
		"key": {
			"width": 9, // Aligns keys to this width
			"type": "string", // string, icon, both, or none
		},
	},
	"modules": [
		{
			"type": "os",
			"key": "os",
			"format": "{name}",
		},
		{
			"type": "uptime",
			"key": "uptime",
			"format": "{hours} Hours {minutes} Minutes",
		},
		{
			"type": "shell",
			"key": "shell",
			"format": "{exe-name}",
		},
		{
			"type": "cpu",
			"key": "cpu",
			"format": "{name}",
		},
		{
			"type": "memory",
			"key": "mem",
			"format": "{used}/{total}",
		},
		{
			"type": "disk",
			"key": "disk",
			"format": "{size-used}/{size-total}",
		},
		"break",
		{
			"type": "colors",
			"symbol": "block",
			"brightness": "normal",
		},
	],
}
